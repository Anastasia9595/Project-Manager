---
import AppLayout from "@/layouts/app.astro"
import { getDictionary } from "@/i18n"
import { CustomerContactDetailPage } from "@/components/customer-contacts/customer-contact-detail-page"
import { isDirectusError } from "@directus/sdk"
import { getRequestSession } from "@/lib/auth/request-session"
import { fetchCustomerContact } from "@/lib/customer-contacts-repository"

const session = getRequestSession(Astro.cookies, Astro.locals)
if (!session) return Astro.redirect("/login")

const dict = getDictionary(Astro.currentLocale ?? "de")

let contact
try {
  contact = await fetchCustomerContact(
    session.tokens.accessToken,
    Astro.params.id ?? "",
    dict.customerContactsPage.form.positions
  )
} catch (error) {
  // Unbekannte oder nicht erlaubte ID -> 404, alles andere ist ein echter Fehler.
  if (!isDirectusError(error)) throw error
  return new Response(null, { status: 404 })
}
---

<AppLayout title={`${contact.customer} – ${dict.sidebar.companyProfile}`}>
  <div class="p-6">
    <CustomerContactDetailPage
      client:load
      contact={contact}
      locale={Astro.currentLocale}
    />
  </div>
</AppLayout>
