---
import AppLayout from "@/layouts/app.astro"
import { getDictionary } from "@/i18n"
import { ProjectsPage } from "@/components/projects/projects-page"
import { canViewInternalWork } from "@/lib/auth/roles"
import { getRequestSession } from "@/lib/auth/request-session"
import { fetchProjects } from "@/services/projects/projects.repository"

const session = getRequestSession(Astro.cookies, Astro.locals)
if (!session) return Astro.redirect("/login")

const locale = Astro.currentLocale ?? "de"
const dict = getDictionary(locale)
const isInternal = canViewInternalWork(Astro.locals.user!.role)
const projects = await fetchProjects(session.tokens.accessToken, {
  includeHandover: isInternal,
})
---

<AppLayout title={dict.sidebar.projects}>
  <div class="p-6">
    <ProjectsPage
      client:load
      locale={locale}
      projects={projects}
      canCreate={isInternal}
    />
  </div>
</AppLayout>
