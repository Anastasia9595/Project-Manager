---
import "@workspace/ui/globals.css"

interface Props {
  title?: string
}

const { title = "Project Tracker" } = Astro.props
const locale = Astro.currentLocale ?? "de"
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
