---
/** Sticky Seitenkopf: Titel und Untertitel statisch, Aktionen (Wochennavigation) per Slot. */
interface Props {
  title: string
  subtitle: string
}

const { title, subtitle } = Astro.props
---

<header
  class="sticky top-0 z-20 -mx-6 flex flex-wrap items-center justify-between gap-4 border-b border-border bg-background px-6 py-4"
>
  <div>
    <h1 class="text-2xl font-bold text-foreground">{title}</h1>
    <p class="text-sm text-muted-foreground">{subtitle}</p>
  </div>
  <slot />
</header>
